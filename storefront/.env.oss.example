# 阿里云 OSS 部署配置（复制为 .env.oss 后填写，.env.oss 已被 git 忽略）
# 用法： source .env.oss && bash deploy-oss.sh

# 已开启"静态页面托管"的存储桶名
OSS_BUCKET=nesthome-storefront

# OSS 地域节点（与桶所在地域一致）
# 华东1(杭州) oss-cn-hangzhou.aliyuncs.com
# 华北2(北京) oss-cn-beijing.aliyuncs.com
# 华南1(深圳) oss-cn-shenzhen.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# RAM 子账号 AccessKey（仅授予该桶的 OSS 权限）
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret

# 可选：上传到桶内子目录（留空表示桶根）
OSS_PREFIX=

# 可选：设为 1 时脚本先执行 npm run build 再上传
BUILD_FIRST=0
